# Copy to `.env` and fill in. .env is gitignored.

# Perception server (the GPU box). When you SSH-tunnel it locally use
# 127.0.0.1:9100, otherwise put the GPU box IP.
PERCEPTION_URL=http://127.0.0.1:9100
PERCEPTION_TOKEN=

# Optional: LLM agent backends. Only needed in scripts/experimental/run_agent.py.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
QWEN_VLM_URL=

# Workspace safety box (metres, in arm base frame). The skill layer refuses
# any cartesian target outside this box.
# Object/strategy-specific grasp tuning lives in
# agentic_grasp/grasp_profiles.py.
WS_X_MIN=0.20
WS_X_MAX=0.55
WS_Y_MIN=-0.40
WS_Y_MAX=0.40
WS_Z_MIN=0.05
WS_Z_MAX=0.40

# DOS-W1 hardware
CAM_FRONT_SERIAL=420222072569
CAM_LEFT_SERIAL=347622072392
CAM_RIGHT_SERIAL=347622071407
LEFT_ARM_PORT=50051
RIGHT_ARM_PORT=50053
CALIB_DIR=/home/ubuntu/calib/result

# Distance from arm flange to gripper fingertips along gripper +z (metres).
# Calibrated TCP point in calib/tcp_config.py is currently [0,0,0], so we
# apply this offset manually. Measure your gripper if it differs.
GRIPPER_TCP_OFFSET=0.13
